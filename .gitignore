# Ignore personal and temporary files
.vscode
**.tar

# Ignore forgejo and ghost... Just part of my learning curve in K8s
forgejo/
ghost/

# Ignore secrets like API keys, passwords, and other sensitive information
**/secrets/
**secret**
# UNLESS it is encrypted with SOPS
!**/*.sops.* 

# Terraform type stuff
*.tfvars
.terraform/
*.tfstate
*.tfstate.*

# Ignore local versions of github actions... (act hates queue: max... https://github.com/nektos/act/pull/6152)
.github/workflows/*local*